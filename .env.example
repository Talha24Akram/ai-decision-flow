# Any OpenAI-compatible provider. Copy to .env.local and fill in LLM_API_KEY.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Talk to the local Inngest dev server (npx inngest-cli@latest dev)
INNGEST_DEV=1
# 1 = no model call: a keyword stub answers YES/NO (for demos and tests)
# LLM_STUB=0
